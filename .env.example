# --- MongoDB ---
# MongoDB Atlas connection string (free M0 cluster is enough).
# The database name itself doesn't matter here — the app always uses
# a database called "forex_roadmap" regardless of what's in this URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
# Authorized redirect URI must be:
#   http://localhost:3000/api/auth/callback/google        (local dev)
#   https://YOUR-VERCEL-DOMAIN/api/auth/callback/google   (production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- NextAuth ---
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Local dev: http://localhost:3000
# Production: your real Vercel URL, e.g. https://forex-roadmap.vercel.app
NEXTAUTH_URL=http://localhost:3000
